# Copy to .env and fill in. Never commit .env.

POSTGRES_USER=mushare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mushare
DB_HOST_PORT=5432

# Used when running the backend / tests outside Docker (host -> published db port).
# Hosting platforms' postgres:// URLs are accepted and converted automatically.
DATABASE_URL=postgresql+asyncpg://mushare:change-me@127.0.0.1:5432/mushare

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Signs access tokens. At least 32 characters; rotating it signs everyone out.
SECRET_KEY=

ENVIRONMENT=development          # "production" turns on Secure cookies and hides API docs
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=["http://localhost:5173"]

# Stories
STORY_TTL_HOURS=24
STORY_PURGE_INTERVAL_SECONDS=600

# My Studio uploads. "local" keeps files on disk under MEDIA_ROOT (needs a persistent volume);
# "s3" uses any S3-compatible bucket, which is what you want on hosts with ephemeral disks.
STORAGE_BACKEND=local
MEDIA_ROOT=media
S3_BUCKET=
S3_ENDPOINT_URL=                 # blank for AWS; set for R2, Backblaze, SeaweedFS, ...
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Sign-in throttling: failed attempts allowed per (IP, email) per window.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Production container only
SEED_CATALOG=true                # load the demo catalog on start (idempotent)
WEB_PORT=8080                    # docker-compose.prod.yml
FORWARDED_ALLOW_IPS=127.0.0.1    # proxies whose X-Forwarded-For uvicorn may trust
