# Single-container build for hosts where a free web service can't talk to a private one
# (Render free tier): nginx serves the frontend and proxies /api to uvicorn on localhost.
# Build context is the repo root:  docker build -f Dockerfile.render .

# ---- build the static site
FROM node:22-alpine AS web
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit
COPY frontend/ ./
RUN npm run build

# ---- API + nginx
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.10 /uv /usr/local/bin/uv
RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MEDIA_ROOT=/data/media \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    FORWARDED_ALLOW_IPS=127.0.0.1

WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev

COPY backend/ ./
COPY --from=web /app/dist /usr/share/nginx/html
COPY frontend/nginx.conf.template /etc/nginx/site.conf.template
COPY frontend/security-headers.inc /etc/nginx/conf.d/security-headers.inc
COPY deploy/single/nginx.conf /etc/nginx/nginx.single.conf
COPY deploy/single/start.sh /app/start.sh

RUN chmod +x docker-entrypoint.sh start.sh \
    && useradd --create-home --uid 1000 appuser \
    && mkdir -p /data/media \
    && chown -R appuser /app /data/media
USER appuser

# nginx listens here (the platform's PORT); uvicorn stays on 127.0.0.1:8000.
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8080/api/health',timeout=4)" || exit 1

CMD ["./start.sh"]
